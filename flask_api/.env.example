# Configuration de la plateforme Raased (API Flask)

# Base de données PostgreSQL (utiliser une base dédiée à la démo)
# Pour SQLite (démo rapide sans serveur) : DATABASE_URL=sqlite:///./raased_platform.db
DATABASE_URL=postgresql+psycopg://raased:raased@localhost:5432/raased_platform
AUTO_CREATE_DB=1
AUTO_SEED=1

# Sécurité
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=480
PASSWORD_TOKEN_EXPIRE_MINUTES=15

# Frontend (liens d'invitation dans les emails)
FRONTEND_URL=http://localhost:3000

# Codes de vérification
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
INVITATION_TTL_HOURS=48

# SMTP — vide = mode dev (les codes sont affichés dans la console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
EMAIL_FROM=no-reply@raased.ma
EMAIL_FROM_NAME=Raased

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Port du serveur Flask
PORT=5000